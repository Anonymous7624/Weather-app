[Unit]
Description=Clearer Weather - NWS weather dashboard for Raspberry Pi
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/clearer-weather
Environment="PATH=/home/pi/clearer-weather/venv/bin"
Environment="DEFAULT_LOCATION=Boston, MA"
Environment="PORT=5050"
ExecStart=/home/pi/clearer-weather/venv/bin/gunicorn -w 1 -b 0.0.0.0:5050 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
