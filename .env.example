# Clearcast - Environment Configuration
# Copy to .env and adjust as needed

# Default location shown on first visit (ZIP, city/state, or lat,lon)
# If empty, user must search
DEFAULT_LOCATION=Boston, MA

# Port to bind (default: 5050)
PORT=5050

# Cache TTL in seconds (default: 600 = 10 minutes)
CACHE_TTL_SECONDS=600

# Set to 1 for Flask debug mode (development only)
FLASK_DEBUG=0

# Secret key for session handling (change in production)
SECRET_KEY=change-this-to-a-random-string-in-production
